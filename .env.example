# ─── Launch stack (keep it stupid simple) ───────────────────────────────────
# GitHub → Vercel → Supabase → OpenAI (optional)
#
# NOT used: AWS, Redis, RabbitMQ, queues, ElasticSearch, Kubernetes, microservices.

# Supabase Postgres (Settings → Database → Connection string)
# Pooled URL for the app (port 6543, ?pgbouncer=true):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL for Prisma db push (port 5432):
# After schema changes (e.g. MoneyItem enums, EventPrepState): npx pnpm@9.15.0 db:push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-char-secret"

# ASC Click Helper (browser extension ↔ Cursor). Same value in extension Options.
ASC_HELPER_SECRET=""

# Transactional email (Resend — https://resend.com)
# 1. Resend → Domains → add mymotivelife.com → verify DNS
# 2. Resend → API Keys → create → copy re_…
# 3. Vercel Production env (then redeploy):
RESEND_API_KEY=""
# Verified sender, e.g. MotiveLife <hello@mymotivelife.com>
EMAIL_FROM="MotiveLife <hello@mymotivelife.com>"
# Admin login + product feedback email alerts (comma-separated)
ADMIN_EMAILS="you@example.com"

# MotiveFX Ops link from MotiveLife /admin (new tab). Local dev example:
# NEXT_PUBLIC_MOTIVEFX_OPS_URL="http://127.0.0.1:5280/?view=admin"
NEXT_PUBLIC_MOTIVEFX_OPS_URL="https://www.motivefxai.com/?view=admin"

# OpenAI — OPTIONAL at launch. Leave empty = $0 AI spend (rule-based briefing works fine).
OPENAI_API_KEY=""
# Google AI (Gemini) — marketing images without OpenAI. Get key: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=""
# free | paygo | enterprise — shown in Ops Console Platform monitor tier card
GOOGLE_AI_TIER="free"
# Image generation model (Gemini API)
GOOGLE_AI_IMAGE_MODEL="gemini-2.5-flash-image"
# auto | gemini | openai | browser | pollinations | cloudflare | puter
MARKETING_IMAGE_PROVIDER="auto"
# Free — Pollinations (flux model, no key required; optional key for higher limits)
POLLINATIONS_API_KEY=""
POLLINATIONS_IMAGE_MODEL="flux"
# Free — Cloudflare Workers AI (~10k neurons/day). Dashboard → Workers AI → Use REST API
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_AI_IMAGE_MODEL="@cf/black-forest-labs/flux-1-schnell"
# Free — Puter (puter.com/dashboard → Create token). Uses your Puter account credits.
PUTER_AUTH_TOKEN=""
PUTER_IMAGE_MODEL="gpt-image-1-mini"
# MotiveIQ-style: local Playwright worker (pnpm gemini:worker). Production admin needs tunnel or use API key above.
GEMINI_BROWSER_WORKER_URL="http://127.0.0.1:8765"
GEMINI_BROWSER_WORKER_SECRET=""
GEMINI_BROWSER_WORKER_PORT="8765"
# Optional — Vercel deploy status in Ops Console Platform monitor
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
SUPABASE_PROJECT_REF=""
# Set to "false" to disable AI even when a key is present (staging / cost freeze)
ENABLE_OPENAI="true"

# Stripe — three CAD monthly prices (create in Product catalog, then paste IDs)
# Secret key: Dashboard → Developers → API keys → Secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=""
#
# 1) MotiveLife Pro — $14.99 CAD/mo
#    App also gives a 14-day free trial on signup (no card). Checkout syncs remaining trial days.
STRIPE_PRICE_ID=""
STRIPE_PRICE_LOOKUP_KEY=""
STRIPE_PRODUCT_ID=""
#
# 2) MyMotiveFamily — $19.99 CAD/mo (includes Pro for the household owner)
#    Free Family Map (live location + speed) does NOT need Stripe — product freemium.
STRIPE_FAMILY_PRICE_ID=""
STRIPE_FAMILY_PRICE_LOOKUP_KEY=""
#
# 3) Family Member Twin Pro — +$5 CAD/mo (invited members only; no trial)
STRIPE_MEMBER_PRO_PRICE_ID=""
STRIPE_MEMBER_PRO_PRICE_LOOKUP_KEY=""
#
# Local: run `stripe listen --forward-to localhost:3002/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=""

# Apple IAP / RevenueCat (iOS App Store — required for App Store guideline 3.1.1)
# Public SDK keys (safe for the app binary). Set in EAS secrets + Vercel if needed.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY="appl_..."
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY="goog_..."
# Webhook auth for https://www.mymotivelife.com/api/webhooks/revenuecat
# REVENUECAT_WEBHOOK_SECRET="generate-a-long-random-string"

# Ops Console cost ledger (Admin → Operating costs → Sync auto costs)
# Auto when keys present:
#   OPENAI_ADMIN_KEY (org Costs API; else AiUsageMonthly estimate via OPENAI_API_KEY usage rows)
#   STRIPE_SECRET_KEY → processing fees
#   RESEND_API_KEY (+ optional RESEND_MONTHLY_PLAN_USD / RESEND_INCLUDED_EMAILS / RESEND_OVERAGE_USD_PER_EMAIL)
#   MARKETING_META_ACCESS_TOKEN + MARKETING_META_AD_ACCOUNT_ID → Meta Insights spend
#   TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN → Twilio usage totalprice
# OPENAI_ADMIN_KEY=""
# RESEND_MONTHLY_PLAN_USD="20"
# RESEND_INCLUDED_EMAILS="50000"
# RESEND_OVERAGE_USD_PER_EMAIL="0.0009"
# MARKETING_META_AD_ACCOUNT_ID="123456789"   # digits only (act_ prefix optional)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# Manual still: Vercel, Supabase, Replicate, Buffer, Google Ads, Apple/Play/EAS, domains.

# App — production: https://www.mymotivelife.com
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Vercel Cron — generate with: openssl rand -base64 32
CRON_SECRET=""

# Marketing Agent — auto-post when configured (see docs/AUTO_POST_SETUP.md)
SERPER_API_KEY=""
MARKETING_POST_IMAGE_URL="https://www.mymotivelife.com/icon.png"
# MotiveLife product UI screenshots ship at /marketing/screenshots/* (Today, Voice, Life Graph).
# Override or add more (JSON array). Real UI only — not logos.
# MARKETING_APP_SCREENSHOT_URLS=["https://www.mymotivelife.com/marketing/screenshots/phone-01-today.png"]
# Per-brand overrides for FX / Pulse / IQ (public URLs to real dashboards):
# MARKETING_MOTIVEFX_APP_SCREENSHOT_URLS=[]
# MARKETING_MOTIVEPULSE_APP_SCREENSHOT_URLS=[]
# MARKETING_MOTIVEIQ_APP_SCREENSHOT_URLS=[]
# Image / copy quality
# MARKETING_COPY_MODEL=gpt-4o
# MARKETING_IMAGE_QUALITY=high
# MARKETING_TTS_MODEL=tts-1-hd
# Optional — Grok / xAI for future copy provider
# XAI_API_KEY=
# Optional — AI MP4 clips for 5s video (replicate.com)
REPLICATE_API_TOKEN=""
# Optional — Replicate models for narrated MP4 mux (defaults are fine)
# MARKETING_MUX_MODEL="lucataco/video-audio-merge"
# MARKETING_TOOLKIT_MODEL="fofr/toolkit"
# MARKETING_TOOLKIT_TO_MP4_TASK="convert_input_to_mp4"
# Optional — manual Share button composer URLs (LinkedIn default is MotiveLife motivelife-ai)
# NEXT_PUBLIC_MARKETING_FACEBOOK_COMPOSER_URL="https://www.facebook.com/profile.php?id=1195433160324440"
# NEXT_PUBLIC_MARKETING_INSTAGRAM_CREATE_URL="https://business.facebook.com/latest/composer"
# NEXT_PUBLIC_MARKETING_LINKEDIN_COMPOSER_URL="https://www.linkedin.com/company/motivelife-ai/admin/page-posts/published/"
# Optional — store large GIF/MP4 creatives (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
MARKETING_META_ACCESS_TOKEN=""
# Ad account for Ops cost auto-sync (Insights spend). Digits only or act_…
# MARKETING_META_AD_ACCOUNT_ID=""
# Business portfolio ID — enables owned_pages fallback when Page token exchange fails
MARKETING_META_BUSINESS_ID="231141370893922"
MARKETING_META_PAGE_ID="1106787945861137"
# Optional — dedicated Page token if System User cannot access MotiveLife Page
# MARKETING_MOTIVELIFE_META_ACCESS_TOKEN=""
# Optional fallback — app resolves IG ID from your Page automatically
MARKETING_INSTAGRAM_ACCOUNT_ID="17841418488035030"
MARKETING_LINKEDIN_ACCESS_TOKEN=""
MARKETING_LINKEDIN_ORG_ID=""
# MotiveFX — separate Meta Page + IG for MotiveFX posts (shared token is OK if same Business Manager)
MARKETING_MOTIVEFX_META_PAGE_ID=""
MARKETING_MOTIVEFX_INSTAGRAM_ACCOUNT_ID=""
MARKETING_MOTIVEFX_POST_IMAGE_URL="https://www.motivefxai.com/brand/motivefx-icon.png"
# MotiveFX LinkedIn — separate Developer app on MotiveFX company page (see docs/AUTO_POST_SETUP.md Part E2)
MARKETING_MOTIVEFX_LINKEDIN_ACCESS_TOKEN=""
MARKETING_MOTIVEFX_LINKEDIN_ORG_ID=""
