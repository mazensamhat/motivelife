// ─── Marketing Agent (multi-brand: MotiveLife, MotiveFX, MotiveIQ, MotivePulse) ─

enum MarketingBrand {
  motivelife
  motivefx
  motiveiq
  motivepulse
}

enum MarketingChannel {
  linkedin
  instagram
  facebook
  tiktok
  reddit
  x
  threads
  youtube
  google_search
  google_ads
}

enum MarketingContentKind {
  social_post
  seo_page
  seo_blog
  ad_copy
}

enum MarketingPostStatus {
  draft
  scheduled
  publishing
  published
  failed
}

enum MarketingMediaType {
  image
  gif
  video
}

model MarketingPost {
  id              String               @id @default(cuid())
  brand           MarketingBrand
  channel         MarketingChannel?
  kind            MarketingContentKind @default(social_post)
  status          MarketingPostStatus  @default(draft)
  title           String?
  body            String
  hashtags        String?
  ctaUrl          String?
  /** Final brand landing URL (with UTMs). ctaUrl is the MotiveLife hop /r/m/:id */
  destinationUrl  String?
  imagePrompt     String?
  mediaType       MarketingMediaType?
  mediaMimeType   String?
  mediaUrl        String?
  mediaBlobPath   String?
  mediaData       String?              @db.Text
  narrationData   String?              @db.Text
  narrationMimeType String?
  sourceImageData String?              @db.Text
  sourceImageMimeType String?
  sourceImageMode String?
  /** Channel publish placement: shorts | video | reels | feed | story */
  publishFormat   String?
  /** YouTube privacy: public | unlisted | private */
  publishPrivacy  String?
  metaTitle       String?
  metaDescription String?
  keywords        String?
  adCopy          String?
  slug            String?              @unique
  scheduledAt     DateTime?
  publishedAt     DateTime?
  externalPostId  String?
  publishedUrl    String?
  publishError    String?
  aiBrief         String?
  createdByEmail  String?
  metricImpressions Int?
  metricEngagements Int?
  metricClicks      Int?
  metricsSyncedAt   DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([brand, status])
  @@index([scheduledAt])
  @@index([publishedAt])
}

