// ─── Money Agent ────────────────────────────────────────────────────────────

enum MoneyItemType {
  SAVINGS
  DEBT
  BILL
  HOUSING
  INVESTMENT
  RETIREMENT
  COMMITMENT
  SUBSCRIPTION
  LIVING_EXPENSE
}

model FinancialProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grossAnnualIncome   Float?
  monthlyTakeHome     Float?
  monthlyInvestments  Float?   @default(0)
  retirementTargetAge Int?     @default(65)
  emergencyFundMonths Float?   @default(6)
  householdSize       Int?
  setupComplete       Boolean  @default(false)
  /** Operating cash / checking balance (manual or from statement) */
  liquidBalance       Float?
  /** Buffer inside operating account treated as unavailable */
  safetyFloor         Float?   @default(0)
  /** Emergency reserve excluded from Safe to Spend by default */
  emergencyReserve    Float?   @default(0)
  /** WEEKLY | BIWEEKLY | SEMI_MONTHLY | MONTHLY | IRREGULAR */
  payFrequency        String?
  nextPayday          DateTime?
  /** Day-of-month anchor for monthly / semi-monthly pay */
  paydayAnchorDay     Int?
  /** Expected average lifestyle spend per day (coffee, fuel, groceries burn) */
  lifestyleBurnDaily  Float?   @default(0)
  /** FIXED | VARIABLE — variable uses conservative / expected / high bands */
  incomeKind          String?  @default("FIXED")
  /** Monthly conservative take-home when income is variable */
  incomeConservative  Float?
  /** Monthly high / upside take-home when income is variable */
  incomeHigh          Float?
  /** ISO 4217 preferred display currency (USD, JPY, AED, …) */
  preferredCurrency   String?  @default("USD")
  /** BCP-47 language tag base (en, ja, ar, …) */
  preferredLocale     String?  @default("en")
  /** Bank-switch Transition Mode checklist JSON */
  transitionJson      String?
  /** Predicted-vs-actual snapshots + last forecast compact JSON */
  kashuLearningJson   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MoneyItem {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String?
  goal          Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  type          MoneyItemType
  title         String
  targetAmount  Float?
  currentAmount Float         @default(0)
  dueDay        Int?          // day of month for bills (1–31)
  autoPay       Boolean       @default(false)
  targetDate    DateTime?
  notes         String?
  /** WEEKLY | BIWEEKLY | SEMI_MONTHLY | MONTHLY | ANNUAL | ONE_OFF */
  frequency     String?       @default("MONTHLY")
  intervalDays  Int?
  nextDueDate   DateTime?
  /** MANDATORY | NECESSARY | DISCRETIONARY | LIFESTYLE */
  priority      String?       @default("MANDATORY")
  confidence    Float?
  /** manual | statement | voice | detected */
  source        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, type])
}

/** Uploaded bank/credit statement (PDF/CSV/paste) — no bank connect required */
model KashuStatement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String   @default("text/plain")
  blobPath    String?
  rawText     String
  parsedJson  String?
  status      String   @default("parsed") // uploaded | parsed | applied | failed
  createdAt   DateTime @default(now())

  transactions KashuTransaction[]

  @@index([userId, createdAt])
}

model KashuTransaction {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  statementId     String?
  statement       KashuStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  postedAt        DateTime
  description     String
  merchantNorm    String?
  amount          Float
  /** debit | credit */
  direction       String
  balanceAfter    Float?
  /** income | obligation | necessary | lifestyle | discretionary | transfer | refund | reimbursement | emergency | other */
  classification  String?
  isTransfer      Boolean   @default(false)
  isOneOff        Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([userId, postedAt])
  @@index([userId, merchantNorm])
}

/** Detected recurring patterns awaiting user confirmation */
model KashuRecurringCandidate {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantNorm  String
  title         String
  amount        Float
  amountMin     Float?
  amountMax     Float?
  frequency     String
  intervalDays  Int?
  nextDueDate   DateTime?
  priority      String    @default("MANDATORY")
  confidence    Float     @default(0.5)
  autoPay       Boolean   @default(false)
  /** pending | confirmed | dismissed */
  status        String    @default("pending")
  moneyItemId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
}

