generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  birthYear    Int?
  lifeFocuses  String?  // JSON string[] of LifeFocusId
  activeModules String? // JSON string[] of LifeModuleId
  moduleOrder  String?  // JSON string[] of LifeModuleId (display order)
  lifeDestination String? // Life GPS north-star destination label
  lifeDestinationGoalId String? // optional linked Goal for progress
  beliefs      String?  // JSON LifeBelief[] — stable values & identity
  preferences  String?  // JSON LifePreference — how AI should coach
  activeContext String? // JSON LifeContextState — vacation, interview, etc.
  moduleUsage  String?  // JSON ModuleUsageMap — last opened per module for adaptive dashboard
  lifeEngineStreak     Int       @default(0)
  lifeEngineBestStreak Int       @default(0)
  lifeEngineLastDone   DateTime?
  lifeEngineFreezes    Int       @default(1)
  accountabilityPartner String?  // JSON { name: string } — friend accountability
  subscriptionPlan String        @default("trial") // trial | plus | family
  subscriptionStatus String      @default("active") // active | cancelled | paused | past_due
  trialEndsAt        DateTime?
  proExpiresAt       DateTime?  // Admin comp Pro — null = forever (when no Stripe sub)
  stripeCustomerId   String?
  stripeSubscriptionId String?
  /** App Store / RevenueCat — original transaction id for MotiveLife Pro on iOS */
  appleOriginalTransactionId String? @unique
  appleProductId             String?
  revenueCatAppUserId        String?
  termsAcceptedAt        DateTime?
  privacyAcceptedAt      DateTime?
  legalConsentVersion    String?
  marketingEmailConsent  Boolean   @default(false)
  marketingEmailConsentAt DateTime?
  signupCountry          String?
  signupRegion           String?
  signupCity             String?
  signupContinent        String?
  signupLatitude         Float?
  signupLongitude        Float?
  phoneNumber            String?   @unique
  phoneVerifiedAt        DateTime?
  phoneTwoFactorEnabled  Boolean   @default(true)
  voiceOrganizeBonus     Int       @default(0)
  avatarUrl              String?
  resumeText             String?
  resumeFileName         String?
  resumeBlobPath         String?
  resumeUploadedAt       DateTime?
  careerFocusApplicationId String?
  dashboardTourSeenAt    DateTime?
  acquisitionChannel     String?
  /** MarketingPost id from ml_acq_post cookie (per-post attribution). */
  acquisitionPostId      String?
  lastSeenAt             DateTime?
  disabledAt             DateTime?
  passwordHash String
  /** Google Sign-In subject (`sub`) when the account was created or linked via Google. */
  googleSub    String?  @unique
  /** Apple Sign In subject (`sub`) when the account was created or linked via Apple. */
  appleSub     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  goals        Goal[]
  tasks        Task[]
  memories     Memory[]
  briefings    DailyBriefing[]
  reviews      EveningReview[]
  suggestions  SuggestedAction[]
  moments      ProgressMoment[]
  lifeMoments  LifeMoment[]
  graphEdges   LifeGraphEdge[]
  lifeInsights LifeInsight[]
  applications JobApplication[]
  moneyItems   MoneyItem[]
  financialProfile FinancialProfile?
  kashuStatements KashuStatement[]
  kashuTransactions KashuTransaction[]
  kashuRecurringCandidates KashuRecurringCandidate[]
  weeklyReviews WeeklyReview[]
  monthlyReviews MonthlyReview[]
  quarterlyReviews QuarterlyReview[]
  scoreSnapshots DailyScoreSnapshot[]
  integrations UserIntegration[]
  habits       Habit[]
  healthItems  HealthItem[]
  learningItems LearningItem[]
  relationshipItems RelationshipItem[]
  coachingLoops CoachingLoop[]
  lifeXpEntries LifeXpEntry[]
  voiceCaptures VoiceCapture[]
  aiUsageMonthly AiUsageMonthly[]
  usageEvents  UsageEvent[]
  passwordResetTokens PasswordResetToken[]
  phoneVerifications  PhoneVerification[]
  lifeCircleOwned     LifeCircleMember[] @relation("LifeCircleOwner")
  lifeCircleLinked    LifeCircleMember[] @relation("LifeCircleLinked")
  referralsSent       Referral[]         @relation("ReferralsSent")
  referralsReceived   Referral?          @relation("ReferralsReceived")
  notifications       Notification[]
  devicePushTokens    DevicePushToken[]
  productFeedback     ProductFeedback[]
  eventPrepStates     EventPrepState[]
  autoPilotActions    AutoPilotAction[]
  healthMetrics       HealthMetric[]
  healthProfile       HealthProfile?
  vitaluWeightLogs    VitaluWeightLog[]
  vitaluFoodLogs      VitaluFoodLog[]
  vitaluWorkouts      VitaluWorkout[]
  vitaluSavedMeals    VitaluSavedMeal[]
  familyHouseholdOwned FamilyHousehold?  @relation("FamilyHouseholdOwner")
  familyMemberships    FamilyMember[]    @relation("FamilyMemberUser")
  locationCirclesOwned LocationCircle[]  @relation("LocationCircleOwner")
  locationCircleMemberships LocationCircleMember[] @relation("LocationCircleMemberUser")
}

// ─── MyMotiveFamily — Intelligent Family Map ───────────────────────────────

model FamilyHousehold {
  id          String   @id @default(cuid())
  ownerUserId String   @unique
  owner       User     @relation("FamilyHouseholdOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String   @default("My Family")
  inviteCode  String   @unique
  /** Purchased +2 seat packs (0–2). Base plan includes 6; max 10 with both packs. */
  extraSeatPacks Int   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     FamilyMember[]
  places      FamilyPlace[]
  roadReports FamilyRoadReport[]

  @@index([inviteCode])
}

/** Household-crowdsourced road alerts (police / events) shown as Route Orbs. */
model FamilyRoadReport {
  id          String   @id @default(cuid())
  householdId String
  household   FamilyHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberId    String
  member      FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /** police | other (concerts / gatherings family wants on the map) */
  kind        String
  title       String
  detail      String   @default("")
  lat         Float
  lng         Float
  /** Reports expire so stale traps don't linger. */
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([householdId, expiresAt])
  @@index([memberId, createdAt])
}

model FamilyMember {
  id                   String    @id @default(cuid())
  householdId          String
  household            FamilyHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?     @relation("FamilyMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  displayName          String
  /** Household relationship — Wife, Son, Mom, Grandfather, etc. */
  relationshipLabel    String?
  role                 String    @default("MEMBER") // OWNER | MEMBER
  color                String    @default("#00c6ff")
  locationSharingLevel String    @default("precise") // precise|approximate|destination_only|eta_only|driving_status_only|off
  shareDrivingData     Boolean   @default(true)
  sharePlaceHistory    Boolean   @default(true)
  shareRoutineLearning Boolean   @default(true)
  shareFamilyInsights  Boolean   @default(true)
  /** Feed this member's own movement into their private Digital Twin / Money / Travel */
  shareDigitalTwinIntegration Boolean @default(true)
  /** Recipient toggles — what *you* want to hear about the household */
  alertArrive          Boolean   @default(true)
  alertLeave           Boolean   @default(true)
  alertDriving         Boolean   @default(true)
  alertRoadHazards     Boolean   @default(true)
  alertStillThere      Boolean   @default(true)
  alertNoShow          Boolean   @default(true)
  isSimulated          Boolean   @default(false)
  simRouteKey          String?   // home_bound | grocery | soccer | campus
  memberKind           String    @default("ADULT") // ADULT | TEEN | CHILD
  guardianUserId       String?
  lastLat              Float?
  lastLng              Float?
  lastAccuracyM        Float?
  lastSpeedKmh         Float?
  lastHeadingDeg       Float?
  lastBatteryPercent   Int?
  lastLocationAt       DateTime?
  presenceStatus       String    @default("unknown") // stationary|moving|driving|unknown
  statusLabel          String?
  currentPlaceId       String?
  /** When the member entered currentPlaceId — used for accurate dwell / stay history */
  currentPlaceEnteredAt DateTime?
  likelyDestination    String?
  destinationConfidence Float?
  etaMinutes           Int?
  /** Personal vehicle — used for fuel / energy cost intelligence */
  vehicleMake          String?
  vehicleModel         String?
  vehicleYear          Int?
  fuelType             String?   // gas|diesel|hybrid|ev
  engineSummary        String?
  litresPer100km       Float?
  kwhPer100km          Float?
  fuelPriceCadPerLitre Float?    @default(1.55)
  evPriceCadPerKwh     Float?    @default(0.14)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  trips          FamilyTrip[]
  locationEvents FamilyLocationEvent[]
  routineStats   FamilyRoutineStat[]
  placeVisits    FamilyPlaceVisit[]
  roadReports    FamilyRoadReport[]

  @@unique([householdId, userId])
  @@index([householdId])
  @@index([userId])
}

/** Closed (and open) place stays for Life360-style Today history. */
model FamilyPlaceVisit {
  id          String    @id @default(cuid())
  memberId    String
  member      FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  placeId     String?
  placeName   String
  /** Always stored so unsaved stops (e.g. parents’ house) still map in history */
  lat         Float?
  lng         Float?
  arrivedAt   DateTime
  departedAt  DateTime?
  dwellMinutes Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([memberId, arrivedAt])
  @@index([memberId, isActive])
}

model FamilyRoutineStat {
  id               String   @id @default(cuid())
  memberId         String
  member           FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  placeName        String
  dayOfWeek        Int      // 0=Sun … 6=Sat
  hourBucket       Int      // 0–23 arrival/presence hour
  sampleCount      Int      @default(0)
  totalDwellMin    Int      @default(0)
  usualLeaveMinute Int?     // minutes from midnight
  usualArriveMinute Int?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([memberId, placeName, dayOfWeek, hourBucket])
  @@index([memberId, placeName])
}

model LocationCircle {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation("LocationCircleOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  type        String   // FAMILY | FRIENDS | CUSTOM
  inviteCode  String   @unique
  householdId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members LocationCircleMember[]

  @@index([ownerUserId])
  @@index([inviteCode])
  @@index([type])
}

model LocationCircleMember {
  id                 String    @id @default(cuid())
  circleId           String
  circle             LocationCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?     @relation("LocationCircleMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  displayName        String
  role               String    @default("MEMBER") // OWNER | MEMBER
  sharingLevel       String    @default("precise")
  shareUntil         DateTime?
  memberKind         String    @default("ADULT")
  color              String    @default("#22c55e")
  lastLat            Float?
  lastLng            Float?
  lastBatteryPercent Int?
  lastLocationAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([circleId, userId])
  @@index([circleId])
  @@index([userId])
}

model FamilyPlace {
  id                  String    @id @default(cuid())
  householdId         String
  household           FamilyHousehold @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name                String
  lat                 Float
  lng                 Float
  radiusM             Float     @default(120)
  category            String    @default("other") // home|work|school|shop|sports|other
  /** Geofence shape: circle | square/box (radiusM = radius or half-height in meters) */
  shape               String    @default("circle")
  /** Box only: rotation in degrees (0 = axis-aligned, counter-clockwise). */
  rotationDeg         Float     @default(0)
  /** Box only: east/north half-extent ratio (1 = square, >1 = wider building). */
  aspectRatio         Float     @default(1)
  /** Life360-style geofence: notify household when someone enters */
  notifyOnEnter       Boolean   @default(true)
  /** Notify household when someone leaves */
  notifyOnLeave       Boolean   @default(true)
  visitCount          Int       @default(0)
  totalDwellMin       Int       @default(0)
  lastVisitedAt       DateTime?
  mostCommonVisitorId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([householdId, name])
  @@index([householdId])
}

model FamilyTrip {
  id                 String    @id @default(cuid())
  memberId           String
  member             FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fromLabel          String
  toLabel            String    @default("In progress")
  startLat           Float
  startLng           Float
  endLat             Float?
  endLng             Float?
  distanceKm         Float     @default(0)
  durationMinutes    Float     @default(0)
  avgSpeedKmh        Float     @default(0)
  maxSpeedKmh        Float     @default(0)
  hardBraking        Int       @default(0)
  rapidAcceleration  Int       @default(0)
  unusualRouteEvents Int       @default(0)
  /** Times the phone was in-use (app foreground) while driving. */
  phoneUsageEvents   Int       @default(0)
  driveScore         Int       @default(90)
  sampleCount        Int       @default(1)
  speedSum           Float     @default(0)
  estimatedFuelLitres Float?
  estimatedFuelKwh    Float?
  estimatedFuelCostCad Float?
  startedAt          DateTime
  endedAt            DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([memberId, startedAt])
  @@index([memberId, isActive])
}

model FamilyLocationEvent {
  id         String   @id @default(cuid())
  memberId   String
  member     FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  speedKmh   Float?
  headingDeg Float?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([memberId, recordedAt])
}

model ProductFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // wish | change | praise | bug
  message   String
  pagePath  String?
  viewport  String?  // mobile | tablet | desktop
  userAgent String?
  status    String   @default("new") // new | reviewed | planned | done
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/** Expo / APNs / FCM push tokens for lock-screen family alerts. */
model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LifeCircleMember {
  id           String   @id @default(cuid())
  ownerUserId  String
  owner        User     @relation("LifeCircleOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  linkedUserId String?
  linkedUser   User?    @relation("LifeCircleLinked", fields: [linkedUserId], references: [id], onDelete: SetNull)
  displayName  String
  relationship String   // FRIEND | FAMILY
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerUserId, linkedUserId])
  @@index([ownerUserId])
  @@index([linkedUserId])
}

model Referral {
  id         String   @id @default(cuid())
  inviterId  String
  inviter    User     @relation("ReferralsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId  String   @unique
  invitee    User     @relation("ReferralsReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  bonusUnits Int      @default(5)
  createdAt  DateTime @default(now())

  @@index([inviterId])
}

model PhoneVerification {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String
  purpose     String   // signup | login | reset
  challengeId String   @unique
  codeHash    String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([phoneNumber, purpose])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Admin analytics: module activity (Ops Console) ─────────────────────────

model UsageEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     String
  action     String   @default("open")
  durationMs Int?
  statusCode Int      @default(200)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([module, createdAt])
}

// ─── Public site traffic (Ops Console) ──────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  source    String   @default("direct")
  medium    String?
  campaign  String?
  /** utm_content / MarketingPost id for per-post attribution */
  content   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
  @@index([path, createdAt])
  @@index([content, createdAt])
}

// ─── Progress Graph: Goals ──────────────────────────────────────────────────

enum LifeDomain {
  CAREER
  MONEY
  HEALTH
  PROJECTS
  HABITS
  LEARNING
  RELATIONSHIPS
  TRAVEL
  BUSINESS
  DREAMS
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  domain      LifeDomain
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  progress    Int        @default(0) // 0-100
  /** Optional total cost Kashu should plan for */
  targetAmount Float?
  /** Optional monthly contribution Kashu should test against cash-flow */
  monthlyContribution Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tasks Task[]
  applications JobApplication[]
  moneyItems   MoneyItem[]
  habits       Habit[]
  healthItems  HealthItem[]
  learningItems LearningItem[]
  relationshipItems RelationshipItem[]
  coachingLoops CoachingLoop[]

  @@index([userId, status])
}

// ─── Progress Graph: Tasks ──────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId      String?
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  isMission   Boolean      @default(false) // Today's Mission flag
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status])
  @@index([userId, isMission])
}

// ─── AI Memory (user-controlled) ────────────────────────────────────────────

enum MemoryType {
  FACT
  PREFERENCE
  COMMITMENT
  ACHIEVEMENT
}

model Memory {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  type      MemoryType @default(FACT)
  domain    LifeDomain?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

// ─── Voice Capture — spoken life input ────────────────────────────────────────

model VoiceCapture {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript String
  summary    String?
  mood       String?
  signals    String?  // JSON string[]
  actions    String   // JSON VoiceCaptureResult actions
  source     String   @default("capture")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── AI usage (monthly rollup for cost control) ─────────────────────────────

model AiUsageMonthly {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthKey           String   // e.g. "2026-06"
  voiceOrganizeUnits Int      @default(0)
  briefingCalls      Int      @default(0)
  eveningCalls       Int      @default(0)
  weeklyCalls        Int      @default(0)
  voiceAiCalls       Int      @default(0)
  inputTokens        Int      @default(0)
  outputTokens       Int      @default(0)
  estimatedMicroUsd  Int      @default(0) // USD × 1_000_000
  updatedAt          DateTime @updatedAt

  @@unique([userId, monthKey])
  @@index([userId, monthKey])
}

// ─── Daily Experience ───────────────────────────────────────────────────────

model DailyBriefing {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  priorities      String   // JSON array of top 3 priorities
  mission         String?  // Today's Mission text
  suggestedAction String?
  summary         String?
  aiExtras        String?  // JSON { hero, coach } from persona-aware LLM
  createdAt       DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
  COMPLETED
}

enum AgentType {
  CAREER
  MONEY
  CALENDAR
  TASK
  HEALTH
  LEARNING
  TRAVEL
  GENERAL
}

model SuggestedAction {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     AgentType        @default(GENERAL)
  title     String
  reason    String?
  status    SuggestionStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, status])
}

// ─── Lives Moved Forward ────────────────────────────────────────────────────

enum ProgressType {
  TASK_COMPLETED
  GOAL_COMPLETED
  MILESTONE
}

model ProgressMoment {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      ProgressType
  domain    LifeDomain?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

// ─── Life Graph™ — connected life entities ──────────────────────────────────

enum GraphNodeType {
  GOAL
  TASK
  MONEY_ITEM
  HEALTH_ITEM
  LEARNING_ITEM
  APPLICATION
  HABIT
  LIFE_MOMENT
  DESTINATION
}

enum GraphRelation {
  FUNDS
  REQUIRES
  ENABLES
  TRIGGERS
  SUPPORTS
  LINKED_TO
}

model LifeGraphEdge {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromType   GraphNodeType
  fromId     String
  toType     GraphNodeType
  toId       String
  relation   GraphRelation  @default(LINKED_TO)
  label      String?
  createdAt  DateTime       @default(now())

  @@index([userId, fromType, fromId])
  @@index([userId, toType, toId])
}

// ─── Life Moments — permanent record of a person's life ─────────────────────

enum LifeMomentCategory {
  CAREER
  MONEY
  HEALTH
  LEARNING
  RELATIONSHIPS
  LIFE_EVENT
  PERSONAL
}

model LifeMoment {
