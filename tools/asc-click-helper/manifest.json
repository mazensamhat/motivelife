{
  "manifest_version": 3,
  "name": "MotiveLife Click Helper",
  "version": "1.5.4",
  "description": "Survive extension reload (no context-invalidated crash); clearer secret errors; blob latest fix.",
  "permissions": ["activeTab", "clipboardWrite", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "MotiveLife Click Helper",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/page-reader.js", "content/steps.js", "content/coach.js", "content/overlay.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
