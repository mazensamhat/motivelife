{
  "manifest_version": 3,
  "name": "MotiveLife Click Helper",
  "version": "1.6.1",
  "description": "ASC coach only — no all-sites thrash. Throttled DOM reads.",
  "permissions": ["activeTab", "clipboardWrite", "storage", "tabs"],
  "host_permissions": [
    "https://appstoreconnect.apple.com/*",
    "https://www.mymotivelife.com/*",
    "https://mymotivelife.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "MotiveLife Click Helper",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://appstoreconnect.apple.com/*"],
      "js": ["content/page-reader.js", "content/steps.js", "content/coach.js", "content/overlay.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
