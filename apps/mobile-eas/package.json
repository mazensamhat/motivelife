{
  "name": "motivelife-mobile-eas",
  "version": "1.0.27",
  "main": "index.ts",
  "private": true,
  "description": "MotiveLife iOS/Android shell via Expo + EAS — loads https://www.mymotivelife.com",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:ios": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:preview:guarded": "powershell -ExecutionPolicy Bypass -File ./scripts/build-preview.ps1",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "expo": "~56.0.17",
    "expo-apple-authentication": "~56.0.4",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.24",
    "expo-health-connect": "0.1.1",
    "expo-image-picker": "~56.0.22",
    "expo-location": "~56.0.0",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.24",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-health-connect": "^3.5.3",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-purchases": "^9.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.6",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
